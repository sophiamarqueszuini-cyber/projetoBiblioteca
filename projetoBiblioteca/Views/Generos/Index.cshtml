@model List<Genero>
@{
    ViewData["Title"] = "Gêneros";
    int status = ViewBag.Status;
}

<h2>Gêneros @(status == 0 ? "(excluídos)" : "")</h2>

<div class="d-flex flex-wrap gap-2 mb-3">
    @if (status == 1)
    {
        <a asp-action="Cadastrar" class="btn btn-primary">Cadastrar novo gênero</a>
        <a asp-action="Index" asp-route-status="0" class="btn btn-outline-secondary">Ver excluídos</a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar para ativos</a>
    }
    <form asp-action="Index" method="get" class="d-flex ms-auto gap-2">
        <input type="hidden" name="status" value="@status" />
        <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome" />
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </form>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nome</th>
            <th class="text-center">Livros ativos</th>
            <th>Cadastrado em</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td class="text-center">@item.QtdLivros</td>
                <td>@item.DataCadastro.ToString("dd/MM/yyyy")</td>
                <td class="text-end text-nowrap">
                    @if (status == 1)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Deseja realmente excluir este gênero?');">
                            <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reativar" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">Reativar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" class="text-center text-muted">Nenhum registro encontrado.</td></tr>
        }
    </tbody>
</table>
