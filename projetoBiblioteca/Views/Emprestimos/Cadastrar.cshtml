@model Emprestimo
@{
    ViewData["Title"] = "Novo Empréstimo";
    List<Livro> livros = ViewBag.Livros;
}

<h2>Novo Empréstimo</h2>

<div class="alert alert-info">
    Data do empréstimo: <strong>@DateTime.Today.ToString("dd/MM/yyyy")</strong> &nbsp;|&nbsp;
    Devolução prevista: <strong>@DateTime.Today.AddDays(Emprestimo.DiasEmprestimo).ToString("dd/MM/yyyy")</strong>
    (@Emprestimo.DiasEmprestimo dias, prorrogável uma vez por mais @Emprestimo.DiasProrrogacao @(Emprestimo.DiasProrrogacao == 1 ? "dia" : "dias"))
</div>

<form asp-action="Cadastrar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3 col-md-8">
        <label asp-for="LeitorId" class="form-label fw-bold"></label>
        <select asp-for="LeitorId" asp-items="ViewBag.Leitores" class="form-select">
            <option value="0">-- selecione o leitor --</option>
        </select>
        <span asp-validation-for="LeitorId" class="text-danger"></span>
    </div>

    <div class="d-flex flex-wrap align-items-end gap-2 mb-2">
        <div>
            <label class="form-label fw-bold mb-0">Livros</label>
            <div class="small text-muted">Marque um ou mais livros (somente os que têm exemplar disponível).</div>
        </div>
        <input type="text" id="filtroLivros" class="form-control ms-auto" style="max-width:320px" placeholder="Filtrar por título, autor ou gênero" />
    </div>
    <span asp-validation-for="LivrosIds" class="text-danger d-block mb-2"></span>

    <div class="table-responsive border rounded" style="max-height:380px; overflow-y:auto">
        <table class="table table-sm table-hover align-middle mb-0" id="tabelaLivros">
            <thead class="table-light" style="position:sticky; top:0">
                <tr>
                    <th style="width:40px"></th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Gênero</th>
                    <th class="text-center">Disponíveis</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var livro in livros)
                {
                    var marcado = Model.LivrosIds.Contains(livro.Id);
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" class="form-check-input chk-livro" name="LivrosIds"
                                   value="@livro.Id" id="livro_@livro.Id" checked="@marcado" />
                        </td>
                        <td><label for="livro_@livro.Id" class="w-100" style="cursor:pointer">@livro.Titulo</label></td>
                        <td>@livro.AutorNome</td>
                        <td>@livro.GeneroNome</td>
                        <td class="text-center">@livro.QuantidadeDisponivel</td>
                    </tr>
                }
                @if (livros.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted">Nenhum livro disponível no momento.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            Registrar empréstimo (<span id="qtdSelecionados">0</span> livro(s))
        </button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Conta quantos livros estão marcados
        function atualizarContador() {
            document.getElementById('qtdSelecionados').textContent =
                document.querySelectorAll('.chk-livro:checked').length;
        }
        document.querySelectorAll('.chk-livro').forEach(c => c.addEventListener('change', atualizarContador));
        atualizarContador();

        // Filtro rápido da tabela de livros
        document.getElementById('filtroLivros').addEventListener('input', function () {
            const termo = this.value.toLowerCase();
            document.querySelectorAll('#tabelaLivros tbody tr').forEach(tr => {
                tr.style.display = tr.textContent.toLowerCase().includes(termo) ? '' : 'none';
            });
        });
    </script>
}
