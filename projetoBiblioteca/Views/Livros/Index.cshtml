@model List<Livro>
@{
    ViewData["Title"] = "Livros";
    int status = ViewBag.Status;
}

<h2>Livros @(status == 0 ? "(excluidos)" : "")</h2>

<div class="d-flex flex-wrap gap-2 mb-3">
    @if (status == 1)
    {
        <a asp-action="Cadastrar" class="btn btn-primary">Cadastrar novo livro</a>
        <a asp-action="Index" asp-route-status="0" class="btn btn-outline-secondary">Ver excluídos</a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar para ativos</a>
    }
    <form asp-action="Index" method="get" class="d-flex ms-auto gap-2">
        <input type="hidden" name="status" value="@status" />
        <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Título, autor, gênero ou ISBN" />
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </form>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Título</th>
            <th>Autor</th>
            <th>Gênero</th>
            <th>Ano</th>
            <th class="text-center">Disponíveis</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var livro in Model)
        {
            <tr>
                <td>@livro.Titulo<br /><small class="text-muted">@livro.EditoraNome @(livro.Isbn != null ? "- ISBN " + livro.Isbn : "")</small></td>
                <td>@livro.AutorNome</td>
                <td>@livro.GeneroNome</td>
                <td>@livro.AnoPublicacao</td>
                <td class="text-center">
                    <span class="badge @(livro.QuantidadeDisponivel > 0 ? "bg-success" : "bg-danger")">
                        @livro.QuantidadeDisponivel / @livro.QuantidadeTotal
                    </span>
                </td>
                <td class="text-end text-nowrap">
                    @if (status == 1)
                    {
                        <a asp-action="Edit" asp-route-id="@livro.Id" class="btn btn-sm btn-warning">Editar</a>
                        <form asp-action="Delete" asp-route-id="@livro.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Deseja realmente excluir este livro?');">
                            <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reativar" asp-route-id="@livro.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">Reativar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted">Nenhum livro encontrado.</td></tr>
        }
    </tbody>
</table>
